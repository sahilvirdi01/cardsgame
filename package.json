{
  "name": "bhabhi-thulla",
  "version": "1.0.0",
  "description": "Multiplayer browser card game (Bhabhi / Thulla / Getaway) with voice, video, soundboard and meme reactions.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "gen:gifs": "bash scripts/gen-gifs.sh",
    "test": "node test/engine.js && node test/e2e.js",
    "test:engine": "node test/engine.js",
    "test:e2e": "node test/e2e.js"
  },
  "keywords": [
    "bhabhi",
    "thulla",
    "getaway",
    "card-game",
    "multiplayer",
    "socket.io",
    "webrtc"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
